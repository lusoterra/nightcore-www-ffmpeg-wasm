+// Offline phase 1: queue every input frame until input EOF. Returns 1
+// when frames were queued, 0 when blocked waiting for input, <0 on
+// error. The held input EOF is only forwarded downstream once the
+// study+process passes have fully drained (see activate).
+static int offline_queue_input(AVFilterLink *inlink)
+{
+    AVFilterContext *ctx = inlink->dst;
+    RubberBandContext *s = ctx->priv;
+    int progress = 0;
+
+    for (;;) {
+        AVFrame *in = NULL;
+        int ret = ff_inlink_consume_samples(inlink, 1, s->nb_samples ? s->nb_samples : 16384, &in);
+        if (ret < 0)
+            return ret;
+        if (!ret)
+            break;
+        if (s->nb_queue == s->alloc_queue) {
+            unsigned nalloc = s->alloc_queue ? s->alloc_queue * 2 : 64;
+            AVFrame **nq = av_realloc_array(s->queue, nalloc, sizeof(*nq));
+            if (!nq) {
+                av_frame_free(&in);
+                return AVERROR(ENOMEM);
+            }
+            s->queue = nq;
+            s->alloc_queue = nalloc;
+        }
+        if (s->first_pts == AV_NOPTS_VALUE)
+            s->first_pts = in->pts;
+        s->expected_in += in->nb_samples;
+        s->queue[s->nb_queue++] = in;
+        progress = 1;
+    }
+
+    {
+        int status;
+        int64_t pts;
+        if (ff_inlink_acknowledge_status(inlink, &status, &pts) &&
+            status == AVERROR_EOF)
+            s->eof_in = 1;
+    }
+    return progress;
+}
+
+// Offline phase 2a: study pass over the queued input in order.
+static void offline_study(AVFilterContext *ctx)
+{
+    RubberBandContext *s = ctx->priv;
+
+    // Lets the stretcher size its buffers and hit the exact output
+    // length.
+    rubberband_set_expected_input_duration(s->rbs, (unsigned)s->expected_in);
+    for (unsigned i = 0; i < s->nb_queue; i++) {
+        AVFrame *in = s->queue[i];
+        rubberband_study(s->rbs, (const float *const *)in->data,
+                         in->nb_samples, i == s->nb_queue - 1);
+    }
+    s->studied = 1;
+}
+
+// Offline phase 2b: process the next queued frame (freeing it) and emit
+// one output frame when the stretcher has samples ready. Returns 1 on
+// progress, 0 once the queue is exhausted and the stretcher is drained.
+static int offline_emit(AVFilterLink *inlink)
+{
+    AVFilterContext *ctx = inlink->dst;
+    RubberBandContext *s = ctx->priv;
+    AVFilterLink *outlink = ctx->outputs[0];
+    AVFrame *out;
+    int nb_samples, ret = 0;
+
+    if (s->queue_pos < s->nb_queue) {
+        AVFrame *in = s->queue[s->queue_pos];
+        int last = s->queue_pos == s->nb_queue - 1;
+        rubberband_process(s->rbs, (const float *const *)in->data,
+                           in->nb_samples, last);
+        s->nb_samples_in += in->nb_samples;
+        av_frame_free(&in);
+        s->queue[s->queue_pos++] = NULL;
+    }
+
+    nb_samples = rubberband_available(s->rbs);
+    if (nb_samples > 0) {
+        out = ff_get_audio_buffer(outlink, nb_samples);
+        if (!out)
+            return AVERROR(ENOMEM);
+        out->pts = s->first_pts + av_rescale_q(s->nb_samples_out,
+                     (AVRational){ 1, outlink->sample_rate },
+                     outlink->time_base);
+        nb_samples = rubberband_retrieve(s->rbs, (float *const *)out->data, nb_samples);
+        out->nb_samples = nb_samples;
+        ret = ff_filter_frame(outlink, out);
+        if (ret < 0)
+            return ret;
+        s->nb_samples_out += nb_samples;
+        return 1;
+    }
+
+    // No output ready: progress only while unprocessed input remains.
+    return s->queue_pos < s->nb_queue;
+}
